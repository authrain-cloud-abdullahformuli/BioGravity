# Production environment variables for the Synology DS723+ deployment.
# Copy this file to `.env.prod` on the NAS and fill the placeholders.
# Never commit `.env.prod` — it is gitignored via .env*.

# Image tag the Compose overlay should pull. Default is :latest; pin to a
# specific :sha-XXXXXXX or :vX.Y.Z when rolling back or pinning a release.
IMAGE_TAG=latest

# Public URL the Cloudflare Tunnel routes to this container. Bakes into
# NextAuth callbacks and every Resend invite link.
NEXTAUTH_URL=https://biogravity.example.com

# Random 32+ character secret used by NextAuth to sign session JWTs.
# Generate locally: `openssl rand -base64 48`
NEXTAUTH_SECRET=__FILL_ME__

# Resend (CC-15)
RESEND_API_KEY=__FILL_ME__
RESEND_FROM=BioGravity Invites <invites@mail.example.com>

# Postgres credentials. Rotate from the dev defaults.
# Random 32 chars recommended: `openssl rand -hex 16`
POSTGRES_USER=biogravity
POSTGRES_PASSWORD=__FILL_ME__
POSTGRES_DB=biogravity

# Host bind-mount for the Postgres data directory.
# Default targets a DSM shared folder; override if your `docker` shared
# folder lives elsewhere.
POSTGRES_DATA_DIR=/volume1/docker/biogravity/postgres-data

# Host port the `app` container binds to (loopback only — Cloudflare Tunnel
# is the only ingress). Change this if you have a port collision.
APP_PORT=3020
