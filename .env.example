# Database
DATABASE_URL=postgresql://user:password@localhost:5432/biogravity

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=__FILL_ME__

# Email (Resend) — required to actually deliver invitations.
# When RESEND_API_KEY is unset, invite creation still works and the copy-link
# fallback is shown in the UI.
RESEND_API_KEY=__FILL_ME__
RESEND_FROM="BioGravity Invites <invites@mail.example.com>"
