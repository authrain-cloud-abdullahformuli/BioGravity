# Demo instance configuration.
# Copy to `.env.demo` and fill NEXTAUTH_SECRET. Everything else has a working
# default — the demo stack is disposable, so the defaults are fine as-is.
#
#   cp .env.demo.example .env.demo
#   docker compose -f docker-compose.demo.yml --env-file .env.demo up -d
#   docker compose -f docker-compose.demo.yml --env-file .env.demo run --rm seed

# Image tag to run. Pin to :sha-XXXXXXX or :vX.Y.Z to demo a specific build.
IMAGE_TAG=latest

# Container name prefix. Change it to run more than one demo stack side by
# side, or to make the containers match a deployment name on a shared host.
STACK_NAME=biogravity-demo

# Public URL of the demo instance. Must match how you actually reach it, or
# NextAuth callbacks will bounce. Use your tunnel hostname if exposing it.
NEXTAUTH_URL=http://localhost:3030

# Required. Generate with: openssl rand -base64 48
NEXTAUTH_SECRET=__FILL_ME__

# Host port for the demo app. Deliberately not 3020, so the demo can run
# alongside a real deployment.
DEMO_APP_PORT=3030

# Demo database. Throwaway credentials on an isolated named volume — this
# database is expected to be destroyed and rebuilt.
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=biogravity_demo

# --- Shared, read-only account -------------------------------------------
# Safe to hand out. It joins both seeded projects as a Viewer, so the role
# model blocks every project write.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=biogravity-demo
DEMO_NAME=Demo User

# Set this to the same address to also block the two account-level actions
# that sit outside the project role model: editing the account's own profile
# (which could change the login email and lock everyone out) and creating
# projects on the shared dashboard. Leave blank to allow both.
DEMO_READONLY_EMAIL=demo@example.com

# --- Owner account — keep this private ------------------------------------
# Owns both seeded projects, so it is Admin on them. This is the login to use
# when recording edit flows. Change the password if the instance is reachable
# beyond your LAN.
DEMO_OWNER_EMAIL=curator@example.com
DEMO_OWNER_PASSWORD=biogravity-curator
DEMO_OWNER_NAME=Demo Curator
